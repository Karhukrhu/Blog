---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<rss version="2.0">
<channel>
  <title>Karhukarhu Blog</title>
  <subtitle>Latest posts from Karhukarhu</subtitle>
  <link href="{{ site.url }}/blog/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/blog/" rel="alternate" type="text/html"/>
  
  {% assign sorted_posts = collections.post | sort: 'date' | reverse %}
  {% assign newest_post = sorted_posts | first %}
  <updated>{{ newest_post.date | date: "%Y-%m-%dT%H:%M:%SZ" }}</updated>
  <id>{{ site.url }}/blog/</id>
  <author>
    <name>Karhukarhu</name>
  </author>
  
  {% for post in sorted_posts %}
    {% assign postPath = post.url | url %}
    {% assign absolutePostUrl = site.url | append: postPath %}
    <item>
      <title>{{ post.data.title | xml_escape }}</title>
      <link>{{ absolutePostUrl }}</link>
      <pubDate>{{ post.date | date: "%a %d %b %Y, %H:%M:%S %z" }}</pubDate>
      <guid>{{ post.date | date: "%Y%m%d%H%M%S" | append: post.fileSlug | replace: "-", "" }}</guid>

      {% if post.data.description %}
        <description>{{ post.data.description | xml_escape }}</description>
        <summary>{{ post.data.description | xml_escape }}</summary>
      {% endif %}
      

      
    </item>
  {% endfor %}
</channel>
</rss>
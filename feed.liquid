---
   permalink: /karhukarhu.place/blog/feed.xml
   eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/css" href="https://karhukarhu.place/blog/rss.css" ?>
<feed xmlns="https://www.w3.org/2005/Atom" xmlns:media="https://search.yahoo.com/mrss/">
  <title>Karhukarhu Blog</title>
  <subtitle>Latest posts from Karhukarhu</subtitle>
  <link href="{{ site.url }}/blog/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/blog/" rel="alternate" type="text/html"/>
  
  {% assign sorted_posts = collections.post | sort: 'date' | reverse %}
  {% assign newest_post = sorted_posts | first %}
  <updated>{{ newest_post.date | date: "%Y-%m-%dT%H:%M:%SZ" }}</updated>
  <id>{{ site.url }}/blog/</id>
  <author>
    <name>Karhukarhu</name>
  </author>
  
  {% for post in sorted_posts %}
    {% assign postPath = post.url | url %}
    {% assign absolutePostUrl = site.url | append: postPath %}
    <entry>
      <title>{{ post.data.title | xml_escape }}</title>
      <link href="{{ absolutePostUrl }}" rel="alternate" type="text/html"/>
      <updated>{{ post.date | date: "%Y-%m-%dT%H:%M:%SZ" }}</updated>
      <id>{{ absolutePostUrl }}</id>
      
      {% if post.data.cover %}
        {% assign absoluteCoverUrl = site.url | append: post.data.cover %}
        <link rel="enclosure" type="image/png" href="{{ absoluteCoverUrl }}" />
        <media:content url="{{ absoluteCoverUrl }}" medium="image" />
        <media:thumbnail url="{{ absoluteCoverUrl }}" />
      {% endif %}

      <content type="html"><![CDATA[
        <style>
          @font-face {
            font-family: 'rat';
            src: url('https://karhukarhu.place/assets/rat-typewriter.ttf') format('truetype');
          }

                    .img-center {
            text-align: center !important;
            margin: 15px auto !important;
            width: 100% !important;
          }
          .img-center img, .img-center a {
            display: inline-block !important;
            margin: 0 auto !important;
          }
          
          /* Fallback: Center ANY image just in case it's not in an .img-center div */
          img {
            display: block !important;
            margin: 10px auto !important;
            max-width: 100% !important;
            height: auto !important;
          }
        </style>

        <div style="font-family: 'rat', 'Courier New', monospace; background-color: #c09e81; border-top: 1px solid #f3d5b1; border-bottom: 1px solid #70480d; border-right: 1px solid #70480d; border-left: 1px solid #f3d5b1; border-radius: 5px; padding: 20px; max-width: 800px; margin: 0 auto; overflow: hidden;">

          <img src="https://karhukarhu.place/assets/daisy_200px.png" alt="Daisy decoration" style="float: right; margin: 50px 0 20px 20px; max-width: 100px; height: auto;" />

          <h1 style="font-family: 'rat', 'Courier New', monospace; text-align: center; margin-top: 50px; color: #2d300e; font-size: 15px; font-weight: 300;">
            {{ post.data.title }}
          </h1>

          <div style="color: #432d14; line-height: 1.6; font-size: 11px; font-family: 'rat', 'Courier New', monospace;">
            {{ post.templateContent | makeUrlsAbsolute }}
          </div>

        </div>
      ]]></content>
      
    </entry>
  {% endfor %}
</feed>
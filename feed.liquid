---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Karhukarhu Blog</title>
  <subtitle>Latest posts from Karhukarhu</subtitle>
  <link href="{{ site.url }}/blog/feed.xml" rel="self"/>
  <link href="{{ site.url }}/blog/"/>
  
  {% assign sorted_posts = collections.post | sort: 'date' | reverse %}
  {% assign newest_post = sorted_posts | first %}
  <updated>{{ newest_post.date | date_to_xmlschema }}</updated>
  
  <id>{{ site.url }}/blog/</id>
  <author>
    <name>Karhukarhu</name>
  </author>

  {% for post in sorted_posts %}
    {%- assign absolutePostUrl = post.url | absoluteUrl: site.url -%}
    
    <entry>
      <title>{{ post.data.title | xml_escape }}</title>
      <link href="{{ absolutePostUrl }}"/>
      <updated>{{ post.date | date_to_xmlschema }}</updated>
      <id>{{ absolutePostUrl }}</id>
      <content type="html">{{ post.templateContent | xml_escape }}</content>
    </entry>
  {% endfor %}
</feed>
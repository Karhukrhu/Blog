---
layout: main
---

<div class="post-header">
  <h3>{{ title }}</h3> 
  <div class="post-date">{{ date | niceDate }}</div>
</div>

{{ content }}




<div class="button-wrapper">
<button id="like-btn" class="like-button">
  <span class="like-heart">♡</span>
  <span id="like-count" class="like-count">0</span>
</button>
</div>


<!-- 3. THE JAVASCRIPT (Wrapped in raw tags for Liquid safety) -->
{% raw %}
<script>
  const API = 'https://www.likeslikes.net';
  const url = window.location.href;
  const btn = document.getElementById('like-btn');
  const count = document.getElementById('like-count');
  const heart = document.querySelector('.like-heart');

  // Fetch current like count
  fetch(`${API}/api/v1/likes?url=${encodeURIComponent(url)}`)
    .then(r => r.json())
    .then(({ data }) => {
      count.textContent = data.likes;
      if (data.is_liked) {
        btn.disabled = true;
        heart.textContent = '♥';
      }
    })
    .catch(err => {
      console.error('Error fetching likes:', err);
      count.textContent = '0';
    });

  // Handle click
  btn.addEventListener('click', () => {
    fetch(`${API}/api/v1/likes`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url })
    })
      .then(r => r.json())
      .then(({ data }) => {
        if (data.success) {
          count.textContent = data.likes;
          heart.textContent = '♥';
          btn.disabled = true;
        }
      })
      .catch(err => console.error('Error liking:', err));
  });
</script>
{% endraw %}




<!-- CATEGORIES -->
<p>
  {% for cat in categories %}
    <a href="/categories/{{ cat | slugify }}">{{ cat }}</a>{% unless forloop.last %} {% endunless %}
  {% endfor %}
</p>

<!-- Post Navigation -->
{% assign previousPost = collections.post | getPreviousCollectionItem %}
{% assign nextPost = collections.post | getNextCollectionItem %}

<div class="post-navigation">
  {% if previousPost %}
    <a href="{{ previousPost.url }}" class="nav-link prev">
      ← Previous
    </a>
  {% else %}
    <div></div> <!-- Empty div to keep the layout balanced if there is no previous post -->
  {% endif %}

  {% if nextPost %}
    <a href="{{ nextPost.url }}" class="nav-link next">
      Next →
    </a>
  {% endif %}
</div>
---
layout: main
---

<div class="post-header">
  <h3>{{ title }}</h3> 
  <div class="post-date">{{ date | niceDate }}</div>
</div>

{{ content }}




<div class="button-wrapper"> Like this post →
<button id="like-btn" class="like-button">
  <span class="like-heart">
    <!-- Unliked state: outline heart SVG -->
    <svg id="heart-outline" class="heart-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>
    <!-- Liked state: filled heart SVG (hidden by default) -->
    <svg id="heart-filled" class="heart-svg" style="display: none;" viewBox="0 0 24 24" fill="currentColor" stroke="none">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>
  </span>
  <span id="like-count" class="like-count">0</span>
</button>
</div>


{% raw %}
<script>
  const API = 'https://www.likeslikes.net';
  const url = window.location.href;
  const btn = document.getElementById('like-btn');
  const count = document.getElementById('like-count');
  const heartOutline = document.getElementById('heart-outline');
  const heartFilled = document.getElementById('heart-filled');

  // Fetch current like count
  fetch(`${API}/api/v1/likes?url=${encodeURIComponent(url)}`)
    .then(r => r.json())
    .then(({ data }) => {
      count.textContent = data.likes;
      if (data.is_liked) {
        btn.disabled = true;
        heartOutline.style.display = 'none';
        heartFilled.style.display = 'block';
      }
    })
    .catch(err => {
      console.error('Error fetching likes:', err);
      count.textContent = '0';
    });

  // Handle click
  btn.addEventListener('click', () => {
    fetch(`${API}/api/v1/likes`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url })
    })
      .then(r => r.json())
      .then(({ data }) => {
        if (data.success) {
          count.textContent = data.likes;
          heartOutline.style.display = 'none';
          heartFilled.style.display = 'block';
          btn.disabled = true;
        }
      })
      .catch(err => console.error('Error liking:', err));
  });
</script>
{% endraw %}




<!-- CATEGORIES -->
<p>
  {% for cat in categories %}
    <a href="/categories/{{ cat | slugify }}">{{ cat }}</a>{% unless forloop.last %} {% endunless %}
  {% endfor %}
</p>

<section id="comments" style="margin-top:50px">
  <h3>Leave a Comment</h3>
<form id="c_form" action="https://api.web3forms.com/submit" method="POST" onsubmit="submitForm(event)">
  
  <input type="hidden" name="access_key" value="36606ee4-364b-486f-9615-60ce6b9c6694">
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;">
  <input type="hidden" name="Post_URL" value="{{ page.url }}">
  <input type="hidden" name="Post_Title" value="{{ title }}">

  <div id="c_nameWrapper" class="c-inputWrapper"><label class="c-label c-nameLabel">Name <input class="c-input c-nameInput" type="text" name="name" required /></label></div>
  <div id="c_websiteWrapper" class="c-inputWrapper"><label class="c-label c-websiteLabel">Website (Optional) <input class="c-input c-websiteInput" type="url" name="website" placeholder="https://example.com" /></label></div>
  <div id="c_textWrapper" class="c-inputWrapper"><label class="c-label c-textLabel"><textarea class="c-input c-textInput" name="message" rows="4" cols="50" maxlength="600" required></textarea></label></div>
  
  <button id="c_submitButton" type="submit">Submit</button>
  
  <!-- Success message (hidden by default) -->
  <div id="c_successMessage">
    Thank you for your comment! It will appear after approval.
  </div>
</form>
</section>

<section id="approved-comments">
  
  {% assign page_comments = comments | where: "slug", page.fileSlug %}

  {% if page_comments.size > 0 %}
    
    <!-- 1. Render Regular Comments First -->
    {% for comment in page_comments %}
      {% unless comment.is_author %}
        <div class="c-comment" id="comment-{{ forloop.index }}">
          <h3 class="c-name">{{ comment.name }}</h3>
          
          {% if comment.website %}
            <a href="{{ comment.website }}" target="_blank" rel="noopener noreferrer" class="c-site">website</a>
          {% endif %}
          
          <span class="c-timestamp">{{ comment.date }}</span>
          <div class="c-text">{{ comment.comment }}</div>
        </div>
      {% endunless %}
    {% endfor %}

    <!-- 2. Render Author Replies Below -->
    {% for comment in page_comments %}
      {% if comment.is_author %}
        
        <div class="c-replyContainer">
          <div class="c-reply">
            
            <!-- Header Row -->
            <div class="c-reply-header">
              <h3 class="c-name">{{ comment.name }}</h3>
              <span class="c-timestamp">{{ comment.date }}</span>
            </div>

            <!-- Text Box -->
            <div class="c-text">{{ comment.comment }}</div>
            
          </div>
        </div>

      {% endif %}
    {% endfor %}

  {% else %}
    <p>No comments yet. Be the first to leave one below!</p>
  {% endif %}
</section>

<script>
async function submitForm(event) {
  event.preventDefault();
  
  const form = event.target;
  const submitBtn = form.querySelector('#c_submitButton');
  const successMsg = form.querySelector('#c_successMessage');
  
  // Disable button while submitting
  submitBtn.disabled = true;
  submitBtn.textContent = 'Submitting...';
  
  // Submit the form via AJAX
  const formData = new FormData(form);
  
  try {
    const response = await fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      body: formData
    });
    
    const result = await response.json();
    
    if (result.success) {
      // Hide the form fields
      form.querySelector('#c_nameWrapper').style.display = 'none';
      form.querySelector('#c_websiteWrapper').style.display = 'none';
      form.querySelector('#c_textWrapper').style.display = 'none';
      submitBtn.style.display = 'none';
      
      // Show success message
      successMsg.style.display = 'block';
    } else {
      alert('Something went wrong. Please try again.');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit';
    }
  } catch (error) {
    console.error('Error:', error);
    alert('Something went wrong. Please try again.');
    submitBtn.disabled = false;
    submitBtn.textContent = 'Submit';
  }
}
</script>
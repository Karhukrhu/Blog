</script>
  	
<script>
  const text = "❀  𝒦𝒶𝓇𝒽𝓊𝓀𝒶𝓇𝒽𝓊.𝓅𝓁𝒶𝒸𝑒  ❀  ";
  let index = 0;
  let isDeleting = false;

  function typeWriter() {
    if (!isDeleting) {
      document.title = text.substring(0, index + 1);
      index++;
      if (index === text.length) {
        isDeleting = true;
        setTimeout(typeWriter, 2000); // Pause for 2 seconds at the end
        return;
      }
    } else {
      document.title = text.substring(0, index - 1);
      index--;
      if (index === 0) {
        isDeleting = false;
        setTimeout(typeWriter, 0); // Pause before typing again
        return;
      }
    }
    setTimeout(typeWriter, isDeleting ? 70 : 70); // Speed of typing/deleting
  }

  typeWriter();
</script>



<script>
  const openBtn = document.getElementById('open-menu-btn');
  const closeBtn = document.getElementById('close-menu-btn');
  const menu = document.getElementById('fullscreen-menu');
  const body = document.body;

  // Function to toggle the menu
  function toggleMenu() {
    menu.classList.toggle('active');
    body.classList.toggle('menu-is-open');
  }

  // Add click events
  openBtn.addEventListener('click', toggleMenu);
  closeBtn.addEventListener('click', toggleMenu);
</script>

<script>
const customCursor = document.getElementById('custom-gif-cursor');

document.addEventListener('mousemove', (e) => {
  // Make the cursor visible on the first movement
  if (customCursor.style.display !== 'block') {
    customCursor.style.display = 'block';
  }
  
  // Move the GIF container to match the exact mouse coordinates
  customCursor.style.left = `${e.clientX}px`;
  customCursor.style.top = `${e.clientY}px`;
});

// Optional: Hide the custom cursor if the mouse leaves the browser window
document.addEventListener('mouseleave', () => {
  customCursor.style.display = 'none';
});
</script>
